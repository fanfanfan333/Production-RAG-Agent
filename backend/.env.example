# ─────────────────────────────────────────────────────────────────────────────
# RAG Agent — environment configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="RAG Agent API"
APP_VERSION="0.1.0"
ENVIRONMENT=development         # development | staging | production
DEBUG=false
LOG_LEVEL=INFO

# ── Google Gemini ──────────────────────────────────────────────────────────────
GOOGLE_API_KEY=your-google-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIMENSION=3072
EMBEDDING_BATCH_SIZE=20

# ── RAG retrieval ──────────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=5
MAX_HISTORY_PAIRS=5

# ── Auth / multi-user (企业落地第一阶段) ───────────────────────────────────────
# REQUIRED in production: generate with `openssl rand -hex 32`.
JWT_SECRET=dev-insecure-secret-change-me
JWT_EXPIRE_MINUTES=720            # 12 h session lifetime
ALLOW_SELF_REGISTRATION=true      # first user always becomes admin; set false
                                  # to have admins create accounts manually
PASSWORD_MIN_LENGTH=8

# ── Rate limiting (per instance, in-process) ───────────────────────────────────
QUERY_RATE_LIMIT=20               # /query calls per user per window
LOGIN_RATE_LIMIT=10               # /auth/login attempts per IP per window
RATE_LIMIT_WINDOW_SECONDS=60

# ── Prompt injection guard ────────────────────────────────────────────────────
# Blocks direct attempts to override system/developer rules before retrieval/LLM.
PROMPT_GUARD_ENABLED=true
PROMPT_GUARD_BLOCK_HIGH_RISK=true
PROMPT_GUARD_MAX_QUERY_CHARS=4096

# ── Application-edge gateway ──────────────────────────────────────────────────
# These are local-service guardrails. At scale, put Kong/APISIX/Envoy in front
# and move rate-limit state to Redis. Never expose Qdrant/Postgres to the host.
GATEWAY_MAX_REQUEST_BYTES=57671680
GATEWAY_AUTH_RATE_LIMIT=10
GATEWAY_UPLOAD_RATE_LIMIT=12
GATEWAY_ADMIN_RATE_LIMIT=60
GATEWAY_ENFORCE_ORIGIN=false       # MUST be true in production
TRUSTED_PROXY_IPS=[]               # e.g. ["172.18.0.2"] for your reverse proxy

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres           # 'postgres' inside Docker, 'localhost' for local dev
POSTGRES_PORT=5432
POSTGRES_USER=raguser
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=ragdb

# ── Qdrant ─────────────────────────────────────────────────────────────────────
QDRANT_HOST=qdrant               # 'qdrant' inside Docker, 'localhost' for local dev
QDRANT_PORT=6333
QDRANT_API_KEY=                  # leave blank for self-hosted; required for Qdrant Cloud
QDRANT_COLLECTION=documents

# ── CORS ───────────────────────────────────────────────────────────────────────
# Development only: ["*"]. Production must list exact web-app origins, e.g.
# ["https://kb.example.internal"] — never use wildcard in production.
CORS_ORIGINS=["*"]

# ── Upload limits ──────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50
MAX_FILES_PER_UPLOAD=10

# ── Chunking ───────────────────────────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ── Document relation analysis (问题1) ────────────────────────────────────────
RELATION_MAX_DOCUMENTS=12        # max documents included in one relation analysis
RELATION_CHUNKS_PER_DOC=8        # chunks sampled per document for its digest
RELATION_DIGEST_CHARS=1200       # max digest chars per document

# ── Embedded-image recognition (问题3) ────────────────────────────────────────
ENABLE_IMAGE_OCR=true            # OCR images embedded inside PDF/DOCX/PPTX
MAX_IMAGES_PER_DOCUMENT=20
MAX_IMAGES_PER_PAGE=6
MIN_IMAGE_DIMENSION=60           # skip icons smaller than this (px)
MAX_IMAGE_OCR_CHARS=600
# Optional multimodal Ollama model used to describe images (e.g. qwen2.5vl:7b).
# Leave empty to use OCR-only recognition.
OLLAMA_VISION_MODEL=
