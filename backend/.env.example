# ─────────────────────────────────────────────────────────────────────────────
# RAG 智能助手 — 后端环境配置
#
# 使用方式：
#     cp .env.example .env
# 然后按需修改。切勿把 .env 提交到 Git（已被 .gitignore 排除）。
#
# 全部配置项都有默认值，最小可用只需要配：
#   JWT_SECRET（生产环境必须改）
#   POSTGRES_PASSWORD
#   OLLAMA_BASE_URL（若 Ollama 不在本机）
# ─────────────────────────────────────────────────────────────────────────────

# ── 应用 ──────────────────────────────────────────────────────────────────────
APP_NAME="RAG Agent API"
APP_VERSION="0.1.0"
ENVIRONMENT=development         # development | staging | production
DEBUG=false
LOG_LEVEL=INFO

# ── Ollama（本地大模型，负责对话 / 生成 / 意图路由 / 证据评估）─────────────────
# 首次使用请先拉取模型：
#     ollama pull qwen3:8b
# 若后端跑在 Docker 容器内、Ollama 在宿主机，用 http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# 上下文窗口。qwen3 默认 40960 会占 ~1.5GB+ 常驻内存，小内存机器容易 OOM。
# RAG 场景 8192 足够（检索上下文 + 对话历史），内存紧张可下调到 4096。
OLLAMA_NUM_CTX=8192
# 可选：多模态模型，用于识别 PDF/DOCX/PPTX 内嵌图片（如 qwen2.5vl:7b）。
# 留空则只走 OCR。
OLLAMA_VISION_MODEL=

# ── BGE 本地向量模型（负责文档与查询的向量化）────────────────────────────────
# 首次启动会自动从 HuggingFace 下载（bge-large-zh 约 1.3GB），请保证网络可用。
BGE_MODEL_NAME=BAAI/bge-large-zh-v1.5
# 必须与所选模型的输出维度一致：
#   bge-small-zh-v1.5 -> 512
#   bge-base-zh-v1.5  -> 768
#   bge-large-zh-v1.5 -> 1024
#   bge-m3            -> 1024
# 修改此项必须重建 Qdrant collection 并重新向量化所有文档。
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=16        # 每批向量化的 chunk 数
EMBEDDING_BATCH_SIZE_FLOOR=2   # 批次失败时动态收缩的下限
MAX_CONCURRENT_EMBEDDINGS=1

# ── 认证与多用户 ──────────────────────────────────────────────────────────────
# 生产环境必须更换，生成方式：openssl rand -hex 32
JWT_SECRET=dev-insecure-secret-change-me-0123456789abcdef0123456789abcdef
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720          # 12 小时会话
ALLOW_SELF_REGISTRATION=true    # 第一个注册的用户自动成为管理员
PASSWORD_MIN_LENGTH=8

# ── 限流（单实例内存级滑动窗口）────────────────────────────────────────────────
QUERY_RATE_LIMIT=20             # 每用户每窗口 /query 次数
LOGIN_RATE_LIMIT=10             # 每 IP 每窗口登录尝试次数
RATE_LIMIT_WINDOW_SECONDS=60

# ── Prompt 注入防护 ───────────────────────────────────────────────────────────
# 在重写 / 检索 / 生成之前做规则检测，拦截越权指令尝试。
PROMPT_GUARD_ENABLED=true
PROMPT_GUARD_BLOCK_HIGH_RISK=true
PROMPT_GUARD_MAX_QUERY_CHARS=4096

# ── 检索（召回 + 精排 + 证据评估 三阶段）─────────────────────────────────────
RETRIEVAL_TOP_K=5               # 每问返回的 chunk 数
RETRIEVAL_MIN_SCORE=0.30        # 余弦相似度下限（bge-zh 优质匹配约 0.4~0.6）
RETRIEVAL_MAX_GAP=0.05          # 与最高分的最大落差，超出则丢弃
MAX_HISTORY_PAIRS=3             # 进入上下文的历史对话轮数

# 混合检索：BM25 关键词 + 向量语义，RRF 融合（Vector TopN + BM25 TopN 同深对齐）
HYBRID_SEARCH_ENABLED=true
HYBRID_MAX_CORPUS_POINTS=10000  # 单次构建 BM25 索引的语料上限
HYBRID_RRF_K=60                 # RRF 平滑常数
HYBRID_CACHE_TTL_SECONDS=300    # BM25 索引缓存时长（秒）
HYBRID_VECTOR_WEIGHT=1.0        # 向量腿 RRF 权重（调大更偏语义相似）
HYBRID_BM25_WEIGHT=1.0          # BM25 腿 RRF 权重（调大更偏精确词/型号编号命中）

MULTI_QUERY_ENABLED=true        # 多查询扩展（多路召回 + RRF 融合）

# Cross-encoder 精排
RERANKER_ENABLED=true
RERANKER_MODEL_NAME=BAAI/bge-reranker-base   # 约 278MB；与 Ollama 同机时注意内存
RERANKER_USE_FP16=false         # 有 CUDA 可开 true 省显存
RERANKER_MAX_CANDIDATES=20      # 送入精排的候选上限（框架图 Candidate Top 20~50）
RERANKER_MAX_TEXT_CHARS=1200    # 打分前截断候选文本（超过 512 token 窗口的部分无效）
RERANKER_USE_QUERY_VARIANTS=false  # 多查询精排（对变体也打分取最大）；质量更稳但推理×N，CPU 建议关
RERANK_MIN_SCORE=0.25           # 精排置信度阈值，低于此值触发拒答守卫
RERANK_MIN_SCORE_FILTER=true    # Relevance Threshold：精排后逐条丢弃低于阈值的候选

# Context Compression：查询感知的句子级上下文压缩（父块回填后防爆上下文）
CONTEXT_COMPRESSION_ENABLED=true
CONTEXT_MAX_CHARS_PER_SOURCE=1500  # 单个 source 的字符预算
CONTEXT_MAX_TOTAL_CHARS=6000       # 全部 source 的总字符软预算
CONTEXT_MIN_SOURCE_CHARS=300       # 总预算耗尽后末位 source 的保底字符数

# LLM 意图路由
ROUTER_ENABLED=true             # 关闭则回退到正则匹配
ROUTER_TIMEOUT_SECONDS=8.0      # 超时自动降级为 knowledge_qa
ROUTER_USE_CACHE=true           # 短时间内相同 query 复用路由结果

# LLM 证据评估 + 自动重试
RETRIEVAL_GRADER_ENABLED=true
RETRIEVAL_GRADER_TIMEOUT_SECONDS=6.0
RETRIEVAL_GRADER_MIN_RELEVANT=1  # 至少 N 个 chunk 判为 relevant 才算证据充分
RETRIEVAL_MAX_RETRIES=2          # 证据不足时的最大改写重试次数
RETRIEVAL_RETRY_ADD_VARIANTS=true # 重试时附带新的查询变体

# ── Evidence Gate（确定性证据门控，fail-closed）───────────────────────────────
# Grader 是 LLM 语义判断（超时/异常即放行 = fail-open），本门是它之后的
# **确定性兜底**：不看语义，只看证据的客观形态，任一信号不达标即拒答。
# 与 Grader 互补，不替代 —— 两者都通过才进入生成。
EVIDENCE_GATE_ENABLED=true
EVIDENCE_GATE_MIN_CHUNKS=1            # 至少 N 条证据
EVIDENCE_GATE_MIN_TOP_SCORE=0.25      # 最高精排分下限（与 RERANK_MIN_SCORE 对齐）
EVIDENCE_GATE_MIN_COVERAGE=0.20       # 问题内容词在证据中的覆盖率下限
# 证据正文总长度下限 —— 这是一道**空壳检查**（只拦"检索返回空/垃圾 payload"），
# 阈值刻意很低：设高会误杀合法的短结构化块（一张 40 字的小表格本身就能回答
# "营收是多少"），证据质量已由分数与覆盖率两个信号把关。
EVIDENCE_GATE_MIN_CHARS=20

# ── Citation Verifier（五项引用校验，Generate 之后）───────────────────────────
# 逐句核验：引用存在？引用位置正确？原文支持该结论？数字一致？日期一致？
# 纯确定性文本比对，不调 LLM。阈值偏保守 —— 宁可漏判，不可错杀
# （误标一条正确引用，比漏掉一条错误引用对用户的伤害更大）。
CITATION_VERIFIER_ENABLED=true
CITATION_MIN_SUPPORT=0.30             # 句子内容词在被引原文中的覆盖率下限
CITATION_MISATTRIBUTION_MARGIN=0.25   # 别条来源高出多少才判"引用位置错误"
CITATION_STRIP_UNSUPPORTED=true       # 移除不被原文支持的引用标记
CITATION_ANNOTATE=true                # 末尾追加一行"引用校验"说明

# ── Output Guard（输出合规净化，Citation Verifier 之后）───────────────────────
# 确定性扫描：越界 [Source N]、系统提示词泄露、闲聊分支幻觉措辞、工具调用意图。
OUTPUT_GUARD_ENABLED=true
OUTPUT_GUARD_BLOCK_ON_LEAK=false      # true 则整段置为拒答；默认仅替换命中短语

# ── 持续监控 + Bad Case 回流 ─────────────────────────────────────────────────
# 运行期指标：证据拒答率 / 引用校验通过率 / 输出净化命中率 / 拒答率 / 时延。
# 自动回流：引用不被支持、证据门控拒答、输出净化命中自动写入 bad_cases 队列，
# 由管理员在「设置 → Bad Case 审阅」中定级与结案（每轮最多回流一条）。
RAG_MONITORING_ENABLED=true
BADCASE_AUTO_CAPTURE=true
BADCASE_AUTO_CAPTURE_LIMIT=20000      # 队列行数软上限（超出时仅记指标）

# ── 文档切分 ──────────────────────────────────────────────────────────────────
MIN_CHUNK_SIZE=500              # 目标最小字符数
MAX_CHUNK_SIZE=2000             # 超过则递归再切
CHUNK_OVERLAP=200               # 相邻 chunk 重叠字符数
CHUNK_TOKEN_AWARE=true          # 按 token 估算而非纯字符数（中英文长度差异）
CHUNK_SENTENCE_OVERLAP=true     # 重叠区在句子边界对齐，不在字符中间断开
CHUNK_PROTECT_BLOCKS=true       # 代码块与 Markdown 表格不从中途拆开
# small-to-big：用更小的子块建索引以精确定位，召回后回填更大的父块给 LLM
HIERARCHICAL_RAG_ENABLED=true
CHUNK_PARENT_SIZE_MULT=2.5      # 父块 = 子块目标大小 × 此倍数
CHUNK_PARENT_OVERLAP=200

# ── 文档关联分析 ──────────────────────────────────────────────────────────────
RELATION_MAX_DOCUMENTS=12       # 单次关联分析纳入的文档数上限
RELATION_CHUNKS_PER_DOC=8       # 每篇文档采样的 chunk 数
RELATION_DIGEST_CHARS=1200      # 每篇文档摘要的最大字符数

# ── 内嵌图片识别（PDF / DOCX / PPTX 中的图片）─────────────────────────────────
ENABLE_IMAGE_OCR=true
MAX_IMAGES_PER_DOCUMENT=20
MAX_IMAGES_PER_PAGE=6
MIN_IMAGE_DIMENSION=60          # 小于此像素的图标跳过
MAX_IMAGE_OCR_CHARS=600

# ── 图片存储（原图落盘 + 原文档归档，用于"返回原始图片"）────────────────────────
ENABLE_IMAGE_SAVE=true          # 关闭则只保留 OCR 文本，无法回显原图
# Docker 部署用 /app/uploads（docker-compose 已挂 uploads_data 持久卷，Dockerfile
# 已建好并授权给非 root 用户）；非 Docker 本地运行请改成相对路径 uploads 或绝对路径。
IMAGE_STORAGE_DIR=/app/uploads
ARCHIVE_ORIGINAL_DOCUMENT=true  # 归档上传的原始文档（original.<ext>）

# 图片作为独立检索对象：图片单独建 chunk（payload 带 content_type=image /
# image_id / image_path），与文本块索引错开；关闭则退回"折进正文"的旧行为。
IMAGE_AS_INDEPENDENT_OBJECT=true

# ── 三层图片处理（Image → Picture Classification → 分流）──────────────────────
# 文档里的图片不再"一律 OCR"，而是先判类型再走不同的处理器：
#
#     Image ─┬─ Table    → Table Parser（框线切网格 + 逐单元格 OCR → Markdown 表格）
#            ├─ Chart    → Vision（图表专用提示词：数据点/坐标轴/图例）
#            ├─ Diagram  → Vision（结构图专用提示词：节点/连线/方向）
#            ├─ Screenshot→ Vision（截图专用提示词：关键字段/代码）
#            └─ Photo/其他→ OCR
#
# 分类器是纯规则实现（横竖线投影 + 色彩统计 + 文字行密度），不依赖任何模型，
# 所以"没有 Vision 模型就先放弃 Vision"时，表格支路依然完整可用。
IMAGE_CLASSIFICATION_ENABLED=true
IMAGE_CLASSIFIER_ENGINE=rules        # rules | rules+vision
TABLE_MIN_H_LINES=3                  # 判为表格图片所需的最少横线数
TABLE_MIN_V_LINES=2                  # 判为表格图片所需的最少竖线数

# 表格结构识别（Table Parser）
TABLE_IMAGE_MIN_ROWS=2               # 还原出的最少行数，低于此值算失败
TABLE_IMAGE_MIN_COLS=2               # 还原出的最少列数
TABLE_IMAGE_MAX_ROWS=200             # 行数上限（防失控大表）
TABLE_IMAGE_MAX_COLS=30              # 列数上限
TABLE_IMAGE_MAX_OCR_CELLS=240        # 逐单元格 OCR 的最大格数（防入库被拖死）
TABLE_IMAGE_VISION_RESCUE=true       # 结构还原失败时，是否让 Vision 直接转写 Markdown

# 哪些图片类型要送 Vision（"看图理解"）；其余类型只用 OCR。
# 设计稿：普通照片走 OCR，只有图表/流程图/截图这类需要读懂图意的才交给多模态模型。
VISION_ANALYZE_TYPES=chart,diagram,screenshot
VISION_CHART_MAX_CHARS=600           # 图表结构化描述截断长度
VISION_DIAGRAM_MAX_CHARS=600         # 流程图/截图描述截断长度

# Tesseract 识别语言。中文知识库必须带 chi_sim；镜像里没装该语言包时代码会
# 自动降级到 eng **并打印告警**（否则中文会静默识别为空）。
#   apt-get install -y tesseract-ocr-chi-sim   # 安装中文语言包
OCR_TESSERACT_LANG=chi_sim+eng

# ── 多引擎图片处理（模型型方案，能力探测 + 置信度门控）──────────────────────────
# 在"三层图片处理"之上，把各环节升级为专用引擎；每个引擎都做运行时能力探测，
# 装不上就自动退回下一条路径，绝不阻塞入库：
#
#   PDF/DOCX 基础解析   → Docling（失败回退 PyMuPDF / python-docx）
#   Layout Detection    → PP-Structure（V3 需 paddleocr≥3.0，2.9.x 自动用 v2）
#   普通 OCR            → PaddleOCR（PP-OCRv3，中文+英文）
#   表格结构（研究型）    → Table Transformer（microsoft/table-transformer-structure-recognition）
#   代码截图            → OCR + Code Parser（纯 Python，无模型）
#   公式               → PaddleOCR Formula（需 paddleocr≥3.0，否则自动跳过）
#   流程图/架构图/描述   → Vision（需多模态模型）
#
# 处理流程：Preprocessing → 专用引擎 → confidence 门控 → 高=Accept / 低=Fallback
#          → Validation → Pass=RAG 入库 / Failed=人工复核

# Docling 负责 PDF/DOCX 正文与结构解析（首次使用会下载版面模型）
DOCLING_ENABLED=true
DOCLING_PDF_ENABLED=false      # PDF 默认仍走 PyMuPDF（保留逐页归属）；复杂版面再开

# PaddleOCR：语言 + 模型版本 + 模型缓存目录
# ⚠️ PADDLE_OCR_VERSION 默认 PP-OCRv3：v4 中文模型会在部分 CPU 上触发 SIGILL，
#    除非确认 CPU 支持，否则不要改 PP-OCRv4。
PADDLE_OCR_LANG=ch
PADDLE_OCR_VERSION=PP-OCRv3
PADDLE_CACHE_DIR=/app/.cache    # 容器内 appuser 的 HOME 不可写时的模型落盘目录

# 版面检测（PP-Structure）
LAYOUT_DETECTION_ENABLED=true

# 表格结构：Table Transformer（首次使用从 HuggingFace 下载约 100+MB 模型）
TABLE_TRANSFORMER_ENABLED=true

# 预处理：对"文档感"强的图（线稿占比高）做几何纠偏
IMAGE_PREPROCESS_GEOMETRIC=true

# ── 图片噪声处理（先量噪声，再决定动不动手）────────────────────────────────────
# 知识库里大多数图是"原生导出"（PDF/PPTX 里的矢量图转位图），几乎没有噪点；
# 对它们去噪只会把笔画磨糊、让 OCR 更差。所以预处理先**估计噪声**再决定：
#   sigma < 阈值        → 一步都不做（干净图）
#   sigma ≥ 阈值        → 按强度自适应去噪（h ∈ [3,18]）+ 对比度归一化
#   四条边都有黑边       → 判为扫描件（去边框 + 纠偏 + 二值化，二值化只进 OCR 通道）
#   sigma ≥ 强噪声       → 进 scan 档，额外做摩尔纹抑制（翻拍屏幕/印刷网点）
# 噪声标准差是 0-255 灰度域的估计值，经验区间：
#   原生导出 ≈ 0.5-1.5   截图 ≈ 2-4   扫描件 ≈ 5-12   翻拍 ≈ 10-25
IMAGE_NOISE_SIGMA_THRESHOLD=4.0       # 超过才去噪
IMAGE_NOISE_SIGMA_STRONG=18.0         # 超过判为强噪声（进 scan 档）
IMAGE_LOW_CONTRAST_SPAN=0.55          # 对比度跨度低于此值算"发灰"，做 CLAHE 归一化
IMAGE_BORDER_TRIGGER_PX=6             # 四边黑边均超过该像素数才判为扫描黑边

# 置信度门控阈值：>=ACCEPT 直接采用；低于 ACCEPT 走兜底；兜底后 >=PASS 且校验通过才入库
IMAGE_CONFIDENCE_ACCEPT=0.75
IMAGE_CONFIDENCE_PASS=0.55

# ── OCR / VLM 双通道（把"失败才兜底"升级为"并行互补"）──────────────────────────
# 原设计里 VLM 只在专用引擎置信度低时登场，于是"OCR 自信地读错"这类失败永远
# 轮不到模型纠正 —— 代码截图最典型：丢了缩进、把 != 读成 =，OCR 仍给 0.9 的
# 置信度，门控直接 Accept。打开后按类型**主动**跑一遍 VLM，与 OCR/结构化通道
# 交叉校验后融合：
#   complementary（table/code/formula）—— 结构通道给骨架，VLM 交叉校验；
#                                        代码用**语法校验**当裁判：谁解析得通就用谁
#   vision-first （chart/diagram/screenshot）—— VLM 主力，OCR 只作文字/数字锚点
#   ocr-first    （photo）—— OCR 够用就不花 VLM 的钱，只有读字不可信才升级
# ⚠️ VLM 是整条链路里最贵的一步（1-5 秒 + 显存），所以只对白名单类型开。
IMAGE_DUAL_CHANNEL_ENABLED=true
IMAGE_DUAL_CHANNEL_TYPES=code,table,formula,chart,diagram,screenshot

# ── 产出质量校验（VLM 解析后的事后质检）───────────────────────────────────────
# 结构形态对 ≠ 内容对。最常见的失败是"形态对但内容是错的"：
#   · 代码截图 → VLM 转写出看起来合理的代码，但括号不配平、def 少了冒号
#   · 扫描件   → OCR 把 1 读成 l、0 读成 O，文本通顺但数字全错
# 所以能形式化验证的就真的去验证：Python 用 ast.parse、JSON 用 json.loads、
# YAML 用 safe_load，其余语言用**字符串感知**的括号/引号配平（print("(") 里的
# 括号不算括号），再叠加 OCR 行置信度与 VLM 幻觉检查（提示词泄漏/复读/数字锚点）。
IMAGE_CODE_SYNTAX_CHECK=true          # 代码类型做真语法校验（关掉只做形态校验）
IMAGE_OCR_CONFIDENCE_MIN=0.65         # 平均行置信度低于此值 → 本次读字不可信
IMAGE_OCR_LOWCONF_RATIO_MAX=0.35      # 低置信行（<0.60）占比超过此值 → 本次读字不可信
IMAGE_VLM_QUALITY_MIN=0.5             # 质检总分低于此值 → 判为未通过，打回兜底/人工复核

# ── Vision 图片理解（图片问答）─────────────────────────────────────────────────
# 打开后前端/LLM 可"看图"；模型未安装时自动降级为纯 OCR，仅启动告警、不阻塞。
# 启用前需先拉取多模态模型：ollama pull qwen2.5vl:7b
VISION_ENABLED=true
VISION_TIMEOUT_SECONDS=60
VISION_CAPTION_MAX_CHARS=400

# Image Context 节点（LangGraph：grade 与 generate 之间）
MULTIMODAL_CONTEXT_ENABLED=true
MAX_VISION_IMAGES_PER_QUERY=3    # 单次提问最多送几张图给 Vision
MULTIMODAL_IMAGE_TEXT_BUDGET=800   # 图片上下文文本预算（字符）

# ── Document Agent（生成 Word 交付物）─────────────────────────────────────────
DOCUMENT_AGENT_ENABLED=true
DOCUMENT_OUTPUT_DIR=/app/uploads/_generated
DOCUMENT_DOWNLOAD_PREFIX=/documents/generated
DOCUMENT_AGENT_MAX_SOURCES=8     # 生成文档最多引用多少个来源片段
DOCUMENT_AGENT_MAX_IMAGES=4      # 最多插入几张原始图片
DOCUMENT_AGENT_MAX_TABLE_ROWS=60 # 单个表格最多还原多少行

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres          # Docker 内填 postgres，本地开发填 localhost
POSTGRES_PORT=5432
POSTGRES_USER=raguser
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=ragdb

# ── Qdrant 向量库 ─────────────────────────────────────────────────────────────
QDRANT_HOST=qdrant              # Docker 内填 qdrant，本地开发填 localhost
QDRANT_PORT=6333
QDRANT_API_KEY=                 # 自建留空；Qdrant Cloud 必填
QDRANT_COLLECTION=documents

# ── 上传限制 ──────────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50
MAX_FILES_PER_UPLOAD=10

# ── 网关 ──────────────────────────────────────────────────────────────────────
GATEWAY_MAX_REQUEST_BYTES=57671680
GATEWAY_AUTH_RATE_LIMIT=10
GATEWAY_UPLOAD_RATE_LIMIT=12
GATEWAY_ADMIN_RATE_LIMIT=60
GATEWAY_ENFORCE_ORIGIN=false    # 生产环境必须设为 true
TRUSTED_PROXY_IPS=[]

# ── CORS ──────────────────────────────────────────────────────────────────────
# 开发环境可用 ["*"]；生产环境必须列出精确来源，
# 例如 ["https://kb.example.com"]，切勿使用通配符。
CORS_ORIGINS=["*"]
